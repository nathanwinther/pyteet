[app]
name = My App
env = production

[cors_headers]
Access-Control-Allow-Origin = *
#Access-Control-Allow-Methods = GET, POST, OPTIONS
#Access-Control-Allow-Headers = Content-Type, Authorization
#Access-Control-Allow-Credentials = true

[database]
default = database_sqlite

# database driver must be one of:
# - mysql
# - postgres
# - sqlite

[database_mysql]
driver = mysql
host = 127.0.0.1
port = 3306
database = app
username = dbuser
password = dbpass
autocommit = True
#ssl_ca = relative/path/to/pem
#ssl_verify_identity = True

[database_postgres]
driver = postgres
host = 127.0.0.1
port = 5432
database = app
username = dbuser
password = dbpass
autocommit = True

[database_sqlite]
driver = sqlite
database = app.db
autocommit = True

[mail]
host = smtp.example.com
port = 587
startssl = True
username = mailuser
password = mailpass
default_sender_name = Hello
default_sender_addr = hello@example.com
